{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 0,
  "panels": [
    {
      "id": 1,
      "type": "gauge",
      "title": "SLI-1: Disponibilidad (% requests exitosos, SLO ≥ 99.5%)",
      "datasource": { "type": "stackdriver", "uid": "gcm" },
      "targets": [
        {
          "datasource": { "type": "stackdriver", "uid": "gcm" },
          "refId": "A",
          "queryType": "promQL",
          "promQLQuery": {
            "projectName": "opentelemetry-nrb",
            "expr": "100 * (sum(rate(http_server_duration_milliseconds_count{http_status_code=~\"2..\"}[5m])) / sum(rate(http_server_duration_milliseconds_count[5m])))",
            "step": "30s"
          },
          "timeSeriesList": { "projectName": "opentelemetry-nrb", "filters": [] }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 99 },
              { "color": "green", "value": 99.5 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Burn Rate 1h — consumo del error budget (PAGE si > 14.4)",
      "datasource": { "type": "stackdriver", "uid": "gcm" },
      "targets": [
        {
          "datasource": { "type": "stackdriver", "uid": "gcm" },
          "refId": "A",
          "queryType": "promQL",
          "promQLQuery": {
            "projectName": "opentelemetry-nrb",
            "expr": "((sum(rate(http_server_duration_milliseconds_count{http_status_code=~\"5..\"}[1h])) or vector(0)) / sum(rate(http_server_duration_milliseconds_count[1h]))) / 0.005",
            "step": "30s"
          },
          "timeSeriesList": { "projectName": "opentelemetry-nrb", "filters": [] }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 14.4 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 0 }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Saturación — requests en vuelo",
      "datasource": { "type": "stackdriver", "uid": "gcm" },
      "targets": [
        {
          "datasource": { "type": "stackdriver", "uid": "gcm" },
          "refId": "A",
          "queryType": "promQL",
          "promQLQuery": {
            "projectName": "opentelemetry-nrb",
            "expr": "sum by (job) (http_server_active_requests)",
            "step": "30s"
          },
          "timeSeriesList": { "projectName": "opentelemetry-nrb", "filters": [] }
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 0 }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "SLI-2: Latencia p50 / p95 / p99 (SLO p95 < 500ms)",
      "datasource": { "type": "stackdriver", "uid": "gcm" },
      "targets": [
        {
          "datasource": { "type": "stackdriver", "uid": "gcm" },
          "refId": "A",
          "queryType": "promQL",
          "promQLQuery": {
            "projectName": "opentelemetry-nrb",
            "expr": "histogram_quantile(0.50, sum by (le, job) (rate(http_server_duration_milliseconds_bucket[5m])))",
            "step": "30s"
          },
          "timeSeriesList": { "projectName": "opentelemetry-nrb", "filters": [] }
        },
        {
          "datasource": { "type": "stackdriver", "uid": "gcm" },
          "refId": "B",
          "queryType": "promQL",
          "promQLQuery": {
            "projectName": "opentelemetry-nrb",
            "expr": "histogram_quantile(0.95, sum by (le, job) (rate(http_server_duration_milliseconds_bucket[5m])))",
            "step": "30s"
          },
          "timeSeriesList": { "projectName": "opentelemetry-nrb", "filters": [] }
        },
        {
          "datasource": { "type": "stackdriver", "uid": "gcm" },
          "refId": "C",
          "queryType": "promQL",
          "promQLQuery": {
            "projectName": "opentelemetry-nrb",
            "expr": "histogram_quantile(0.99, sum by (le, job) (rate(http_server_duration_milliseconds_bucket[5m])))",
            "step": "30s"
          },
          "timeSeriesList": { "projectName": "opentelemetry-nrb", "filters": [] }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 500 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "SLI-3: Error Rate por servicio (% 5xx, SLO ≤ 0.5%)",
      "datasource": { "type": "stackdriver", "uid": "gcm" },
      "targets": [
        {
          "datasource": { "type": "stackdriver", "uid": "gcm" },
          "refId": "A",
          "queryType": "promQL",
          "promQLQuery": {
            "projectName": "opentelemetry-nrb",
            "expr": "100 * (sum by (job) (rate(http_server_duration_milliseconds_count{http_status_code=~\"5..\"}[5m])) or sum by (job) (rate(http_server_duration_milliseconds_count[5m])) * 0) / sum by (job) (rate(http_server_duration_milliseconds_count[5m]))",
            "step": "30s"
          },
          "timeSeriesList": { "projectName": "opentelemetry-nrb", "filters": [] }
        },
        {
          "datasource": { "type": "stackdriver", "uid": "gcm" },
          "refId": "B",
          "queryType": "promQL",
          "promQLQuery": {
            "projectName": "opentelemetry-nrb",
            "expr": "vector(0.5)",
            "step": "30s"
          },
          "timeSeriesList": { "projectName": "opentelemetry-nrb", "filters": [] }
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0 }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "SLI-4: Throughput (RPS por servicio)",
      "datasource": { "type": "stackdriver", "uid": "gcm" },
      "targets": [
        {
          "datasource": { "type": "stackdriver", "uid": "gcm" },
          "refId": "A",
          "queryType": "promQL",
          "promQLQuery": {
            "projectName": "opentelemetry-nrb",
            "expr": "sum by (job) (rate(http_server_duration_milliseconds_count[5m]))",
            "step": "30s"
          },
          "timeSeriesList": { "projectName": "opentelemetry-nrb", "filters": [] }
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Latencia DB p99",
      "datasource": { "type": "stackdriver", "uid": "gcm" },
      "targets": [
        {
          "datasource": { "type": "stackdriver", "uid": "gcm" },
          "refId": "A",
          "queryType": "promQL",
          "promQLQuery": {
            "projectName": "opentelemetry-nrb",
