{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 0,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "SLI-1 Disponibilidad (SLO ≥ 99.5%)",
      "datasource": { "type": "stackdriver", "uid": "gcm" },
      "targets": [
        {
          "datasource": { "type": "stackdriver", "uid": "gcm" },
          "refId": "A",
          "queryType": "promQL",
          "promQLQuery": {
            "projectName": "opentelemetry-nrb",
            "expr": "sum(rate(http_server_duration_milliseconds_count{http_status_code=~\"2..\"}[5m])) / sum(rate(http_server_duration_milliseconds_count[5m]))",
            "step": "10s"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit", "min": 0, "max": 1,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null },
            { "color": "green", "value": 0.995 }
          ] }
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "SLI-3 Error rate (SLO ≤ 0.5%)",
      "datasource": { "type": "stackdriver", "uid": "gcm" },
      "targets": [
        {
          "datasource": { "type": "stackdriver", "uid": "gcm" },
          "refId": "A",
          "queryType": "promQL",
          "promQLQuery": {
            "projectName": "opentelemetry-nrb",
            "expr": "sum(rate(http_server_duration_milliseconds_count{http_status_code=~\"5..\"}[5m])) / sum(rate(http_server_duration_milliseconds_count[5m]))",
            "step": "10s"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit", "min": 0,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "red", "value": 0.005 }
          ] }
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Burn rate 1h (PAGE si > 14.4)",
      "datasource": { "type": "stackdriver", "uid": "gcm" },
      "targets": [
        {
          "datasource": { "type": "stackdriver", "uid": "gcm" },
          "refId": "A",
          "queryType": "promQL",
          "promQLQuery": {
            "projectName": "opentelemetry-nrb",
            "expr": "(sum(rate(http_server_duration_milliseconds_count{http_status_code=~\"5..\"}[1h])) / sum(rate(http_server_duration_milliseconds_count[1h]))) / 0.005",
            "step": "30s"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short", "min": 0,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "orange", "value": 1 },
            { "color": "red", "value": 14.4 }
          ] }
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "SLI-4 Saturación (requests en vuelo)",
      "datasource": { "type": "stackdriver", "uid": "gcm" },
      "targets": [
        {
          "datasource": { "type": "stackdriver", "uid": "gcm" },
          "refId": "A",
          "queryType": "promQL",
          "promQLQuery": {
            "projectName": "opentelemetry-nrb",
            "expr": "sum by (job) (http_server_active_requests)",
            "step": "10s"
          }
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "SLI-2 Latencia p95 (SLO < 500ms)",
      "datasource": { "type": "stackdriver", "uid": "gcm" },
      "targets": [
        {
          "datasource": { "type": "stackdriver", "uid": "gcm" },
          "refId": "A",
          "queryType": "promQL",
          "promQLQuery": {
            "projectName": "opentelemetry-nrb",
            "expr": "histogram_quantile(0.95, sum by (le, job) (rate(http_server_duration_milliseconds_bucket[5m])))",
            "step": "15s"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "red", "value": 500 }
          ] }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 }
    },
